<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net6.0</TargetFramework>
    <HostModelAssemblyPath Condition="'$(HostModelAssemblyPath)' == ''">$(MSBuildBinPath)/Microsoft.NET.HostModel.dll</HostModelAssemblyPath>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Microsoft.NET.HostModel">
      <HintPath>$(HostModelAssemblyPath)</HintPath>
    </Reference>
  </ItemGroup>
</Project>
